# ---------------------------------------------------------------------------
# KHI Dashboard — environment template
#
# Copy to `.env.local` for local development, or pass these to the container
# at build/run time in production. Never commit a file with real values.
#
# IMPORTANT: `NEXT_PUBLIC_*` values are inlined into the client bundle at BUILD
# time, not read at runtime. They must be present during `next build` (see the
# ARG/ENV block in the Dockerfile), and changing one requires a rebuild.
# ---------------------------------------------------------------------------

# Server-only. Origin of the KHI backend API. Every browser request is proxied
# through `/railway-proxy`, which forwards to this host with the correct Host
# header and injects the httpOnly auth cookie as a Bearer token.
# Never prefix this with NEXT_PUBLIC_ — it must not reach the browser.
API_PROXY_TARGET=https://api.example.com

# Base URL the browser uses for API calls. Keep this as the same-origin proxy
# path: it avoids CORS entirely and lets the httpOnly cookie authenticate.
# Only point it straight at the backend if that backend sends CORS headers for
# this dashboard's origin — in which case auth falls back to the Bearer header.
NEXT_PUBLIC_API_URL=/railway-proxy

# Public-facing KHI website. Used to build "view on site" links and to resolve
# `metadataBase` for the dashboard's own metadata.
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional. Display label for the public site shown next to those links.
# Falls back to the hostname of NEXT_PUBLIC_SITE_URL when unset.
NEXT_PUBLIC_SITE_LABEL=
